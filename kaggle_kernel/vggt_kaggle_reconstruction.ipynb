   "source": [
    "# MonasteryAI — VGGT-Ω / DUSt3R 3D Video Reconstruction Pipeline\n",
    "**Hardware Accelerator:** GPU (P100 or 2x T4)\n",
    "**Input:** 4K Video Keyframes (The Great Emei Mountain / Pemayangtse)\n",
    "**Output:** 3D Point Cloud & Textured Mesh (.glb) -> Auto-uploaded to Supabase Storage"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Environment & Dependencies Setup\n",
    "!pip install -q trimesh open3d scipy pyrender imageio[ffmpeg]\n",
    "!git clone --recursive https://github.com/naver/dust3r.git\n",
    "%cd dust3r\n",
    "!pip install -r requirements.txt\n",
    "!pip install -r requirements_optional.txt\n",
    "\n",
    "import torch\n",
    "print(f\"PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"Device: {torch.cuda.get_device_name(0)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Load Pretrained VGGT-Ω / DUSt3R Foundation Model\n",
    "from dust3r.model import AsymmetricCroCo3DStereo\n",
    "from dust3r.inference import inference\n",
    "from dust3r.image_pairs import make_pairs\n",
    "from dust3r.cloud_opt import global_aligner, GlobalAlignerMode\n",
    "\n",
    "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "model_path = \"naver/DUSt3R_ViTLarge_BaseDecoder_512_dpt\"\n",
    "print(f\"Loading 3D Foundation Model: {model_path} onto {device}...\")\n",
    "model = AsymmetricCroCo3DStereo.from_pretrained(model_path).to(device)\n",
    "print(\" Model Loaded Successfully.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Ingest Keyframes & Run Global Pairwise Alignment\n",
    "import glob, os\n",
    "from dust3r.utils.image import load_images\n",
    "\n",
    "image_files = sorted(glob.glob(\"/kaggle/input/**/*.jpg\", recursive=True))[:60]\n",
    "if not image_files:\n",
    "    # Fallback to test demo images from dust3r repo\n",
    "    image_files = sorted(glob.glob(\"croco/assets/*.png\"))[:10]\n",
    "\n",
    "print(f\"Processing {len(image_files)} frames for 3D reconstruction.\")\n",
    "images = load_images(image_files, size=512)\n",
    "pairs = make_pairs(images, scene_graph='complete', prefilter=None, symmetrize=True)\n",
    "\n",
    "print(f\"Running Pairwise Visual Geometry Inference on {len(pairs)} image pairs...\")\n",
    "output = inference(pairs, model, device, batch_size=2)\n",
    "\n",
    "print(\"Solving Global Multi-view Point Alignment...\")\n",
    "scene = global_aligner(output, device=device, mode=GlobalAlignerMode.PointCloudOptimizer)\n",
    "loss = scene.compute_global_alignment(init='mst', niter=300, schedule='cosine', lr=0.01)\n",
    "print(f\" Global Alignment Converged. Final Loss: {loss:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Export Dense Colored 3D Mesh (.glb) with Confidence Filtering\n",
    "min_conf_thresh = 50.0\n",
    "out_glb = \"/kaggle/working/monastery_3d_model.glb\"\n",
    "scene.save_glb(out_glb, min_conf_thr=min_conf_thresh, max_points=1000000)\n",
    "print(f\" Exported 3D Scene to {out_glb} (Size: {os.path.getsize(out_glb)/(1024*1024):.2f} MB)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Upload Directly to Supabase Storage Bucket\n",
    "import urllib.request\n",
    "\n",
    "SUPABASE_URL = \"https://ygdmzmqkztwpmkdozzsp.supabase.co\"\n",
    "SUPABASE_SERVICE_KEY = \"YOUR_SUPABASE_KEY"\n",
    "STORAGE_BUCKET = \"monasteries\"\n",
    "DEST_NAME = \"emei_mountain.glb\"\n",
    "\n",
    "if os.path.exists(out_glb):\n",
    "    with open(out_glb, 'rb') as f:\n",
    "        data = f.read()\n",
    "    req = urllib.request.Request(\n",
    "        f\"{SUPABASE_URL}/storage/v1/object/{STORAGE_BUCKET}/{DEST_NAME}\",\n",
    "        data=data,\n",
    "        headers={\n",
    "            'Authorization': f'Bearer {SUPABASE_SERVICE_KEY}',\n",
    "            'apikey': SUPABASE_SERVICE_KEY,\n",
    "            'Content-Type': 'model/gltf-binary',\n",
    "            'x-upsert': 'true'\n",
    "        }\n",
    "    )\n",
    "    with urllib.request.urlopen(req) as resp:\n",
    "        print(f\" Upload Success! Direct CDN URL: {SUPABASE_URL}/storage/v1/object/public/{STORAGE_BUCKET}/{DEST_NAME}\")"
   ]
  }
 ],
