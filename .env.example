# ==============================================================================
# MONASTERYAI — ENVIRONMENT CONFIGURATION (TIER B: ULTRA-COMPACT HACKATHON BUILD)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE MCP & API CREDENTIALS
# ------------------------------------------------------------------------------
# A. Personal Access Token (PAT) for Supabase MCP Server:
# Generate at: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_token

# B. Project API Credentials (for Web/Mobile SDK & Python Scripts):
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# C. Storage Bucket Name for 3D .glb & .spz Models:
SUPABASE_STORAGE_BUCKET=monasteries

# ------------------------------------------------------------------------------
# 2. KAGGLE MCP & GPU AUTOMATION CREDENTIALS
# ------------------------------------------------------------------------------
# Generate at: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_API_TOKEN=your_kaggle_token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ------------------------------------------------------------------------------
# 3. TIER B (ULTRA-COMPACT HACKATHON) CONFIGURATION
# ------------------------------------------------------------------------------
# Target Total App Footprint: < 45 MB
# Target 3D Model File Size: < 20 MB (.glb with Draco compression)
# Embedded SLM Engine: SmolLM2-135M-Instruct (INT4 Q4_K_M GGUF, ~75 MB) or 2-bit SLM (~50 MB)
TARGET_APP_SIZE_MB=45
TARGET_3D_SIZE_MB=20
MODEL_REPO=HuggingFaceTB/SmolLM2-135M-Instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2
